# Copier vers .env.local (développement) ou configurer dans Vercel → Settings → Environment Variables.
# Ne jamais committer de secrets.

# --- Site (obligatoire en production pour métadonnées / liens absolus) ---
# URL publique sans slash final, ex. https://www.lexgabon.ga
NEXT_PUBLIC_SITE_URL=

# --- Supabase (auth magic link, client) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Base de données (Drizzle, ingestion) ---
DATABASE_URL=

# --- Meilisearch (recherche /api/search) ---
MEILISEARCH_HOST=
MEILISEARCH_API_KEY=

# --- Chatbot juridique (proxy Next → FastAPI) ---
# URL du service backend Python (sans slash final). Variable **serveur uniquement** (pas NEXT_PUBLIC_*).
# Ex. local : http://127.0.0.1:8000  |  Docker compose : http://backend:8000 (si Next hors compose, utiliser http://localhost:8000)
LEGAL_AGENT_API_BASE_URL=http://127.0.0.1:8000

# RAG / uploads (backend, voir docs/chatbot-env-parity.md)
# CHROMA_UPLOADS_COLLECTION=uploads_session
# CHROMA_EMBEDDING_MODEL=intfloat/multilingual-e5-small
# Alternative (opt-in, réingestion requise) : intfloat/multilingual-e5-base
# USE_HYBRID_RAG=false
# USE_RERANK=false
# RAG_STRUCTURED_CITATIONS=false
# MAX_UPLOAD_PDF_BYTES=10485760

# --- Cron ingestion (POST /api/ingest/cron, header Authorization: Bearer …) ---
CRON_SECRET=

# --- Webhook Supabase (POST /api/webhooks/supabase) ---
# Si défini : header x-supabase-signature doit être égal au secret (comparaison constant-time).
SUPABASE_WEBHOOK_SECRET=

# =============================================================================
# Backend FastAPI (`backend/`, voir backend/README.md) — fichier .env à la racine
# backend/ ou variables passées par Docker Compose :
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# ANTHROPIC_MODEL_FALLBACK=claude-3-5-haiku-20241022
# ANTHROPIC_MAX_TOKENS_WITH_TOOLS=1024
# ANTHROPIC_MAX_TOKENS_TEXT=2048
# CHROMA_PATH=./data/chroma
# FRONTEND_ORIGINS=http://localhost:3000
# REDIS_URL=   # optionnel (sessions + rate limit partagés)
