# Copier vers .env.local (développement) ou configurer dans Vercel → Settings → Environment Variables.
# Ne jamais committer de secrets.

# --- Site (obligatoire en production pour métadonnées / liens absolus) ---
# URL publique sans slash final, ex. https://www.lexgabon.ga
NEXT_PUBLIC_SITE_URL=

# --- Supabase (auth magic link, client) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Base de données (Drizzle, ingestion, retrieval Amaia) ---
# Optionnel au MVP : sans DATABASE_URL, Amaia utilise Meilisearch puis contexte vide.
DATABASE_URL=

# --- Meilisearch (recherche /api/search, fallback retrieval) ---
MEILISEARCH_HOST=
MEILISEARCH_API_KEY=

# --- Anthropic (Ama'IA /api/amaia) ---
# GET /api/amaia (sans auth) renvoie { anthropicConfigured, model } pour contrôle déploiement.
ANTHROPIC_API_KEY=
# Optionnel ; défaut côté code : claude-sonnet-4-20250514
ANTHROPIC_MODEL=

# Optionnel — hôtes supplémentaires autorisés pour le fetch HTML Ama’IA (séparés par des virgules, sans https://)
# AMAIA_FETCH_ALLOWLIST=example.ga,www.example.ga

# --- Cron ingestion (POST /api/ingest/cron, header Authorization: Bearer …) ---
CRON_SECRET=

# --- Webhook Supabase (POST /api/webhooks/supabase) ---
# Si défini : header x-supabase-signature doit être égal au secret (comparaison constant-time).
SUPABASE_WEBHOOK_SECRET=
